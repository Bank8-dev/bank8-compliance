{
  "openapi": "3.1.0",
  "info": {
    "title": "bank8-compliance",
    "description": "Sentin8 Bank8:Compliance - AML/CTF: KYC/CDD, sanctions screening, transaction monitoring, alert/case lifecycle.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/admin/overview": {
      "get": {
        "tags": [
          "admin-ui"
        ],
        "summary": "GET /v1/admin/overview - the data endpoint behind the overview page:\nalert/case counts for the tenant env.",
        "operationId": "admin_overview",
        "parameters": [
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (RLS context)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "alert/case counts",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "bank8:admin": []
          }
        ]
      }
    },
    "/v1/admin/ui/{page}": {
      "get": {
        "tags": [
          "admin-ui"
        ],
        "summary": "GET /v1/admin/ui/{page} - return the RFW definition for the requested\nadmin page.",
        "operationId": "get_admin_ui",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "description": "RFW page name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (RLS context)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "RFW page definition",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "bank8:admin": []
          }
        ]
      }
    },
    "/v1/alerts": {
      "get": {
        "tags": [
          "handlers"
        ],
        "summary": "`GET /v1/alerts` - list alerts, optionally by status.",
        "operationId": "list_alerts",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/alerts/{id}/case": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/alerts/{id}/case` - escalate an alert to a case with an\naudited actor claim (the assignee). The alert transitions to\n`escalated` in the same transaction.",
        "operationId": "open_case",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenCaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/alerts/{id}/status": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/alerts/{id}/status` - queue operation on an alert (claim /\nreview / close) with an audited actor: the caller's verified identity\ndrives the journal entry; the transition is guarded against terminal\nstates (closed alerts never reopen - a new detection raises a new\nalert).",
        "operationId": "update_alert_status",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAlertStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "409": {
            "description": ""
          }
        }
      }
    },
    "/v1/cases/{id}": {
      "get": {
        "tags": [
          "handlers"
        ],
        "summary": "`GET /v1/cases/{id}` - case detail with its alert.",
        "operationId": "get_case",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/cases/{id}/conclude": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/cases/{id}/conclude` - conclude a case as reportable: the\nreport kind lands in `suspicious_activities` and\n`bank8:compliance:suspicious:detected` is emitted exactly once -\nReporting files it through its own durable consume (detection here,\nfiling there - the single-filing-executor rule, DESIGN.md §8).",
        "operationId": "conclude_case",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConcludeCaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/cases/{id}/dismiss": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/cases/{id}/dismiss` - dismiss a case as not reportable:\nthe recorded reason lands in the case row and NO suspicious activity\nis emitted - Reporting never sees a dismissed case (a dismissed\ncase is terminal; a new detection opens a new case).",
        "operationId": "dismiss_case",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DismissCaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "409": {
            "description": ""
          },
          "422": {
            "description": ""
          }
        }
      }
    },
    "/v1/cases/{id}/evidence": {
      "get": {
        "tags": [
          "handlers"
        ],
        "summary": "`GET /v1/cases/{id}/evidence` - the case's investigation evidence:\nthe originating alert, every sanctions screen against its subject,\nand the customer's risk profile (when resolved). Read-only -\nevidence is the input to the conclude/dismiss decision, never\nmutated by it.",
        "operationId": "get_case_evidence",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/customers/{id}/beneficial-owners": {
      "get": {
        "tags": [
          "handlers"
        ],
        "summary": "`GET /v1/customers/{id}/beneficial-owners` - list the customer's\ndisclosed beneficial owners (references only).",
        "operationId": "list_beneficial_owners",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BeneficialOwnerResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/customers/{id}/beneficial-owners` - disclose a beneficial\nowner against a KYC record (idempotent per (kyc, identity_ref) -\nre-disclosing the same owner converges to the same row).",
        "operationId": "disclose_beneficial_owner",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscloseBeneficialOwnerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BeneficialOwnerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers/{id}/kyc": {
      "get": {
        "tags": [
          "handlers"
        ],
        "summary": "`GET /v1/customers/{id}/kyc` - list a customer's KYC records.",
        "operationId": "list_kyc",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KycResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/customers/{id}/kyc` - create a KYC record for a customer.",
        "operationId": "create_kyc",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKycRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KycResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers/{id}/pep": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/customers/{id}/pep` - record a PEP (politically exposed\nperson) determination. One live determination per KYC record - a\nre-determination updates it in place (the latest determination is\nauthoritative; history rides the audit journal).",
        "operationId": "record_pep_determination",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PepDeterminationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/customers/{id}/risk-profile": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/customers/{id}/risk-profile` - upsert the customer's AML\nrisk rating (low/medium/high) with a recorded rationale. The rating\ndrives monitoring intensity; a PEP determination forces at least\n`high` (a PEP can never sit below it).",
        "operationId": "upsert_risk_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRiskProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": ""
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "`GET /v1/health` - service health payload.",
        "description": "Carries the binary's build identity (`version`/`build`, BUILDID-1) so\ncaptain's monitor populates `make status`'s VERSION column for every\ninstance - the consuming BINARY's identity, never a shared crate's.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness (version, build)"
          }
        },
        "security": []
      }
    },
    "/v1/rules": {
      "get": {
        "tags": [
          "handlers"
        ],
        "summary": "`GET /v1/rules` - list the tenant's monitoring rules (thresholds\nderive from the jurisdiction registry - reporting's return-template\ndefinitions - materialized at env-init; never code).",
        "operationId": "list_rules",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MonitoringRuleResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertResponse": {
        "type": "object",
        "description": "An alert as returned by the alert reads.",
        "required": [
          "id",
          "subject",
          "source",
          "source_ref",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "BeneficialOwnerResponse": {
        "type": "object",
        "description": "A beneficial owner as returned by the reads.",
        "required": [
          "id",
          "kyc_id",
          "identity_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identity_ref": {
            "type": "string"
          },
          "kyc_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ConcludeCaseRequest": {
        "type": "object",
        "description": "Request body for concluding a case as suspicious - the report kind\nuses the shared `ReportKind` vocabulary.",
        "required": [
          "report_kind"
        ],
        "properties": {
          "report_kind": {
            "type": "string"
          }
        }
      },
      "CreateKycRequest": {
        "type": "object",
        "description": "Request body for creating a KYC record - the customer id arrives in\nthe path (`/v1/customers/{id}/kyc`); the body carries no duplicate of\nit."
      },
      "DiscloseBeneficialOwnerRequest": {
        "type": "object",
        "description": "Request body for disclosing a beneficial owner - identity by platform\nreference only (a sentin8-secrets:// or identity-plane reference);\ndocument bytes and plaintext identity numbers never enter a bank8\nrow (DESIGN.md §8 invariant).",
        "required": [
          "kyc_id",
          "identity_ref"
        ],
        "properties": {
          "identity_ref": {
            "type": "string"
          },
          "kyc_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DismissCaseRequest": {
        "type": "object",
        "description": "Request body for dismissing a case - the reason is mandatory (a\ndismissal without a recorded reason is unauditable).",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "KycResponse": {
        "type": "object",
        "description": "A KYC record as returned by the KYC reads.",
        "required": [
          "id",
          "customer_id",
          "status"
        ],
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ListAlertsQuery": {
        "type": "object",
        "description": "Query for listing alerts.",
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MonitoringRuleResponse": {
        "type": "object",
        "description": "A monitoring rule as returned by the reads.",
        "required": [
          "id",
          "rule_code",
          "threshold",
          "window",
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "rule_code": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          },
          "window": {
            "type": "string"
          }
        }
      },
      "OpenCaseRequest": {
        "type": "object",
        "description": "Request body for escalating an alert to a case.",
        "required": [
          "assignee"
        ],
        "properties": {
          "assignee": {
            "type": "string"
          }
        }
      },
      "PepDeterminationRequest": {
        "type": "object",
        "description": "Request body for recording a PEP determination against a KYC record.",
        "required": [
          "kyc_id",
          "is_pep"
        ],
        "properties": {
          "is_pep": {
            "type": "boolean"
          },
          "kyc_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UpdateAlertStatusRequest": {
        "type": "object",
        "description": "Request body for an alert-status transition (queue operations - the\nactor claim is audited via the caller's identity in the audit\njournal).",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "UpsertRiskProfileRequest": {
        "type": "object",
        "description": "Request body for upserting the customer's AML risk rating - the\nrationale is mandatory (a rating without its recorded reasoning is\nunauditable).",
        "required": [
          "rating",
          "rationale"
        ],
        "properties": {
          "rating": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "compliance",
      "description": "Bank8:Compliance - AML/CTF: KYC/CDD, sanctions screening, transaction monitoring, alert/case lifecycle"
    }
  ]
}
