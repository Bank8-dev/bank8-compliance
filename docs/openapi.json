   "post": {
    "tags": [
     "handlers"
    ],
    "summary": "`POST /v1/cases/{id}/dismiss` \u2014 dismiss a case as not reportable:\nthe recorded reason lands in the case row and NO suspicious activity\nis emitted \u2014 Reporting never sees a dismissed case (a dismissed\ncase is terminal; a new detection opens a new case).",
    "operationId": "dismiss_case",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
