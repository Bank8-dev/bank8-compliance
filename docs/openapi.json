 "components": {
  "schemas": {
   "AlertResponse": {
    "type": "object",
    "description": "An alert as returned by the alert reads.",
    "required": [
     "id",
     "subject",
     "source",
     "source_ref",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "source": {
      "type": "string"
     },
     "source_ref": {
